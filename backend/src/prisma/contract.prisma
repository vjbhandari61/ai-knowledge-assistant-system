// use prisma-8

model User {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  name      String?
  documents Document[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Document {
  id          Int              @id @default(autoincrement())
  title       String
  fileName    String
  mimeType    String
  fileSize    Int
  storagePath String
  status      String           @default("PENDING")

  user        User             @relation(fields: [userId], references: [id])
  userId      Int

  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  @@index([userId])
}
